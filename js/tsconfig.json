{
    "compilerOptions": {
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "lib": ["ES2022", "DOM"],
        "strict": true,
        "declaration": true,
        "sourceMap": true,
        "outDir": "dist",
        "rootDir": "src",
        "types": ["node"],
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "noUncheckedIndexedAccess": true
    },
    "include": ["src/**/*.ts"]
}
