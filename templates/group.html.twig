{% extends '@TacticMediaQa/layout.html.twig' %}

{% block page_title %}{{ mode|capitalize }} · {{ viewport|replace({'x': '×'}) }}{% endblock %}

{% block page_subtitle %}
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
        Full-page captures from the last journey run. Click a screen to review it.
    </p>
{% endblock %}

{% block review_content %}
    <div class="relative space-y-12" {{ stimulus_controller('qa-anchor-highlight') }}>
    {% for class, screens in screens_by_class %}
        <section>
            <div class="sticky top-0 bg-white pb-4 dark:bg-black">
                <h2 class="text-base/7 font-semibold text-gray-900 dark:text-slate-200">{{ class }}</h2>
                <p class="text-sm text-gray-500 dark:text-gray-400">{{ screens|length }} screens</p>
            </div>

            <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
                {% for screen in screens %}
                    {% set notes = counts_by_screen[screen.name] ?? 0 %}
                    {# Escape on the annotate page returns to this anchor, so the card it lands on is highlighted. #}
                    <a id="{{ screen.anchor }}"
                       href="{{ path('qa_screenshots_annotate', {mode, viewport, name: screen.name}) }}"
                       class="group flex scroll-mt-24 flex-col overflow-hidden rounded-lg border border-gray-200 bg-white shadow-xs hover:border-amber-500 data-anchored:border-amber-500 data-anchored:ring-2 data-anchored:ring-amber-500 dark:border-white/10 dark:bg-white/5 dark:hover:border-amber-400 dark:data-anchored:border-amber-400 dark:data-anchored:ring-amber-400">
                        <div class="h-48 overflow-hidden bg-zinc-100 dark:bg-zinc-800">
                            <img src="{{ path('qa_screenshots_raw', {mode, viewport, name: screen.name}) }}"
                                 alt="{{ screen.label }}" loading="lazy"
                                 class="h-48 w-full object-contain object-top" />
                        </div>
                        <div class="flex flex-1 items-start justify-between gap-2 p-3">
                            <div class="min-w-0">
                                <p class="truncate text-sm font-medium text-gray-900 dark:text-slate-200">{{ screen.label }}</p>
                                <p class="mt-0.5 truncate text-xs text-gray-500 dark:text-gray-400">#{{ screen.sequence }} · {{ screen.method }}</p>
                            </div>
                            {% if notes %}
                                <span class="shrink-0 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-900 dark:bg-amber-400/20 dark:text-amber-200">
                                    {{ notes }}
                                </span>
                            {% endif %}
                        </div>
                    </a>
                {% endfor %}
            </div>
        </section>
    {% endfor %}
    </div>
{% endblock %}
