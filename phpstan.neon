includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    level: 8
    paths:
        - src
        - tests
    # Each fixture host writes its container cache here, so none of these exist in a
    # fresh checkout. (?) marks the path optional rather than a configuration error.
    excludePaths:
        - tests/Fixtures/app/var (?)
        - tests/Fixtures/encore/var (?)
        - tests/Fixtures/reprise/var (?)

    # symfony/reprise needs PHP 8.4 and Symfony 7.4, so it cannot be a dev dependency:
    # the lower CI legs could not install it. Where it is absent this class is not there,
    # and where CI does install it nothing matches - which reportUnmatched allows.
    ignoreErrors:
        -
            identifier: class.notFound
            path: tests/Fixtures/reprise/RepriseKernel.php
            reportUnmatched: false
        -
            identifier: generator.valueType
            path: tests/Fixtures/reprise/RepriseKernel.php
            reportUnmatched: false
